# Copy this file to .env.local and fill in what you need. Everything here is optional, except the form variables if you use the freelance contact form.

# Raises GitHub's rate limit for the My World commit feed.
# Create a fine-grained token with NO permissions (public read-only is enough).
GITHUB_TOKEN=

# Only needed for instant updates when you push to the my-world repo.
# Use the same secret in GitHub: repo Settings > Webhooks > Secret.
GITHUB_WEBHOOK_SECRET=

# Freelance contact form (https://resend.com): see README, "Freelance page and contact form".
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional, once your domain is verified in Resend, e.g. Portfolio <hello@liviabuilds.com>
CONTACT_FROM_EMAIL=
